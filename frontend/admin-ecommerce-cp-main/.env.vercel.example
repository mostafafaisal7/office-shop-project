# ============================================
# ADMIN FRONTEND - VERCEL DEPLOYMENT
# ============================================
# Use these variables when deploying to Vercel
# Add these in Vercel Dashboard → Project Settings → Environment Variables

# ============================================
# BACKEND API CONFIGURATION (cPanel)
# ============================================
# Your cPanel backend URL where FastAPI is running
# Example: https://yourdomain.com or https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com

# Internal API URL - Use same as public URL for Vercel
API_URL=https://yourdomain.com

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Your Vercel URL (will be provided after first deployment)
# Example: https://your-admin-app.vercel.app
# Or your custom domain: https://admin.yourdomain.com
NEXT_PUBLIC_SITE_URL=https://your-admin-app.vercel.app

# ============================================
# IMAGE DOMAINS
# ============================================
# Include your cPanel domain and TinyMCE CDN
# Replace 'yourdomain.com' with your actual cPanel domain
NEXT_PUBLIC_IMAGE_DOMAINS=yourdomain.com,cdn.tiny.cloud

# ============================================
# CONTENT SECURITY POLICY
# ============================================
# Your cPanel backend URL for CSP headers
NEXT_PUBLIC_BACKEND_URLS=https://yourdomain.com

# ============================================
# FEATURE FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=production

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 1. Replace 'yourdomain.com' with your actual cPanel domain
# 2. After first Vercel deployment, update NEXT_PUBLIC_SITE_URL
# 3. Add all these variables in Vercel Dashboard
# 4. Don't forget to update backend CORS settings!
