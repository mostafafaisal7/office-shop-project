# ============================================
# ADMIN FRONTEND PRODUCTION CONFIGURATION
# ============================================
# Copy this file to .env.production and update with your production values

# ============================================
# BACKEND API CONFIGURATION
# ============================================
# Backend API base URL - Use your actual domain
NEXT_PUBLIC_API_URL=https://yourdomain.com

# Internal API URL (for server-side requests)
# If backend is on the same server, use localhost
# Otherwise use the full domain
API_URL=http://localhost:8000

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Site URL - Use your actual domain
NEXT_PUBLIC_SITE_URL=https://admin.yourdomain.com

# ============================================
# IMAGE DOMAINS
# ============================================
# Comma-separated list of allowed image domains
NEXT_PUBLIC_IMAGE_DOMAINS=yourdomain.com,cdn.tiny.cloud

# ============================================
# CONTENT SECURITY POLICY
# ============================================
# Backend URLs for CSP img-src
NEXT_PUBLIC_BACKEND_URLS=https://yourdomain.com

# ============================================
# FEATURE FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=production
