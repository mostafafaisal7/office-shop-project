# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and update with your production values
# IMPORTANT: Never commit the .env file to version control!

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Format: mysql+aiomysql://username:password@host:port/database
# For cPanel: Use the MySQL database credentials from cPanel
DATABASE_URL=mysql+aiomysql://your_db_user:your_db_password@localhost:3306/your_database_name

# Sync database URL for Alembic migrations
# Format: mysql+pymysql://username:password@host:port/database
SYNC_DATABASE_URL=mysql+pymysql://your_db_user:your_db_password@localhost:3306/your_database_name

# ============================================
# APPLICATION URLS
# ============================================
# Backend base URL - where the FastAPI server is accessible
# Production: Use your actual domain
BASE_URL=https://yourdomain.com

# Frontend URLs for email links and CORS
# Production: Use your actual frontend domains
FRONTEND_URL=https://yourdomain.com
ADMIN_FRONTEND_URL=https://admin.yourdomain.com

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# Production: Include all your frontend domains
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

# ============================================
# JWT AUTHENTICATION
# ============================================
# CRITICAL: Generate a secure random key for production
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3600
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# FILE STORAGE
# ============================================
# Static files directory (relative to backend root)
STATIC_DIR=app/static
# Public URL path for static files
STATIC_URL_PATH=/images

# ============================================
# SMS PROVIDER CONFIGURATION
# ============================================
SMS_PROVIDER=greenweb
GREENWEB_API_KEY=your_actual_greenweb_api_key
GREENWEB_URL=http://api.greenweb.com.bd/api.php

# ============================================
# API KEYS
# ============================================
ANTHROPIC_API_KEY=your_actual_anthropic_api_key

# ============================================
# SERVER CONFIGURATION
# ============================================
# Server host and port
HOST=0.0.0.0
PORT=8000
# Environment: production
ENVIRONMENT=production
# Disable debug mode in production
DEBUG=false
